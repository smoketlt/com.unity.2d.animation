<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="SceneEditMeshWindow.uss" />
  <ui:Style src="SceneEditWeightsWindow.uss" />
  <ui:VisualElement class="uniskin-mesh-window uniskin-weights-window">
    <ui:VisualElement name="windowHeader" class="mesh-header">
      <ui:Image name="weightsIcon" picking-mode="Ignore" />
      <ui:Label text="Edit Weights" name="windowTitle" class="mesh-window-title" picking-mode="Ignore" />
      <ui:Button name="closeWindow" text="×" tooltip="Close Edit Weights" />
    </ui:VisualElement>
    <ui:VisualElement name="commands" class="mesh-body">
      <ui:VisualElement class="mesh-block">
        <ui:VisualElement class="mesh-row"><ui:VisualElement name="mode" /><ui:Button name="prune" text="Prune" class="mesh-last-action" /></ui:VisualElement>
        <ui:Slider name="strength" label="Strength" low-value="0" high-value="100" show-input-field="true" />
        <ui:Slider name="size" label="Size" low-value="1" high-value="500" show-input-field="true" />
        <ui:Slider name="feather" label="Feather" low-value="0" high-value="100" show-input-field="true" />
        <ui:VisualElement class="mesh-row">
          <ui:Button name="smooth" text="Smooth" /><ui:Button name="auto" text="Auto" /><ui:Button name="weld" text="Weld" class="mesh-last-action" tooltip="Weight transfer between meshes: workflow pending discussion." />
        </ui:VisualElement>
        <ui:VisualElement class="mesh-row">
          <ui:Button name="copyWeights" text="Copy" tooltip="Copy selected vertex weights in selection order. Rectangle selection uses vertex index order." />
          <ui:Button name="pasteWeights" text="Paste" class="mesh-last-action" tooltip="Paste one vertex to all selected vertices, or equal counts in selection order. Skip vertices missing required bones or conflicting with locked weights." />
        </ui:VisualElement>
        <ui:VisualElement class="mesh-row mesh-options">
          <ui:Toggle name="pieces" text="Pieces" class="mesh-option-toggle" /><ui:Toggle name="overlay" text="Overlay" class="mesh-option-toggle" /><ui:Toggle name="selected" text="Selected" class="mesh-option-toggle" /><ui:Toggle name="triangles" text="Triangles" class="mesh-option-toggle" tooltip="Show all triangle edges on the deformed mesh. Hidden during Preview." /><ui:Toggle name="preview" text="Preview" class="mesh-option-toggle" tooltip="Show only the sprite, hiding weight colors, mesh lines, vertices, bones and brush handles. Editing gestures remain available." />
        </ui:VisualElement>
        <ui:VisualElement class="mesh-row weight-list-title weight-offset-controls">
          <ui:Label text="Bones" class="weight-offset-title" />
          <ui:Button name="weightDecrease" text="−" tooltip="Subtract Step % from the selected bone on each selected vertex." />
          <ui:FloatField name="weightStep" label="Step %" value="5" tooltip="Change in percentage points per selected vertex. Fractional values are supported." />
          <ui:Button name="weightIncrease" text="+" class="mesh-last-action" tooltip="Add Step % to the selected bone on each selected vertex." />
        </ui:VisualElement>
        <ui:ScrollView name="bones" mode="Vertical" />
        <ui:VisualElement class="mesh-row">
          <ui:Button name="bind" text="Bind" tooltip="Click bones to add them to this mesh. Assigned bones are inactive." />
          <ui:Button name="swap" text="Swap" tooltip="Swap two selected bones' weights on selected vertices, or all vertices." />
          <ui:Button name="remove" text="Remove" class="mesh-last-action" tooltip="Unbind selected bones and redistribute their weights. Skeleton bones remain." />
        </ui:VisualElement>
        <ui:VisualElement class="mesh-row">
          <ui:Button name="updateBindings" text="Update Bindings" class="mesh-last-action" tooltip="Use the current bone pose as this mesh's binding pose, keeping its visible shape and weights. Other meshes keep their bindings." />
        </ui:VisualElement>
        <ui:VisualElement class="mesh-row weight-pose-controls">
          <ui:Button name="previewPose" text="Preview Pose" tooltip="With Move, drag a joint to move bones or a bone body to rotate. E/R provides rotation/scale handles. Weight editing is disabled in this mode." />
          <ui:Button name="resetPose" text="Reset Pose" class="mesh-last-action" tooltip="Restore the saved binding pose, preserving current animation samples. Closing Edit Weights also clears temporary preview transforms." />
        </ui:VisualElement>
        <ui:Label name="status" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
