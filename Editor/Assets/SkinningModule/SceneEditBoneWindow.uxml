<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:Style src="SceneEditMeshWindow.uss" />
  <ui:Style src="SceneEditBoneWindow.uss" />
  <ui:VisualElement class="uniskin-mesh-window uniskin-bone-window">
    <ui:VisualElement name="windowHeader" class="mesh-header">
      <ui:Image name="windowIcon" picking-mode="Ignore" />
      <ui:Label text="Edit Bones" name="windowTitle" class="mesh-window-title" picking-mode="Ignore" />
      <ui:Button name="closeWindow" text="×" tooltip="Close Edit Bones" />
    </ui:VisualElement>
    <ui:VisualElement name="commands" class="mesh-body">
      <ui:VisualElement class="mesh-block">
        <ui:VisualElement class="mesh-row">
          <ui:Button name="create" text="Create" tooltip="Drag to create a bone. Click again to return to editing." />
          <ui:Button name="split" text="Split" tooltip="Click a bone body to split it at the cursor." />
          <ui:Button name="setParent" text="Set Parent" tooltip="Select a child, then click its parent. Click empty space to detach." />
        </ui:VisualElement>
        <ui:VisualElement class="mesh-row">
          <ui:Button name="copy" text="Copy" tooltip="Copy selected bones and all descendants." />
          <ui:Button name="paste" text="Paste" tooltip="Paste copied chains under their original parents." />
          <ui:Button name="pasteMirror" text="Paste Mirror" tooltip="Reflect copied chains along their parent bones and swap left/right names." />
        </ui:VisualElement>
        <ui:VisualElement name="properties" class="bone-properties">
          <ui:TextField name="boneName" label="Name" is-delayed="true" tooltip="Rename the bone, its scene GameObjects and animation bindings when saving." />
          <ui:VisualElement class="bone-color-row">
            <uie:ColorField name="boneColor" label="Color" show-alpha="false" hdr="false" />
            <ui:Button name="boneIcon" tooltip="Choose an icon for the selected bones." class="bone-icon-button">
              <ui:Image name="boneIconImage" picking-mode="Ignore" class="bone-icon-image" />
            </ui:Button>
          </ui:VisualElement>
          <ui:VisualElement class="bone-length-size-row">
            <uie:FloatField name="boneLength" label="Length" is-delayed="true" tooltip="Bone length in original source pixels." />
            <uie:FloatField name="boneIconSize" label="Size" is-delayed="true" tooltip="Icon display size in screen points (4–128). Available for custom icons." />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
