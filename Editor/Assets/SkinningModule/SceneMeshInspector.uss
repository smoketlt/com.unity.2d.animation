#uniskinEditMesh { height: 24px; flex-direction: row; justify-content: center; align-items: center; margin-top: 6px; }
#uniskinEditBone { height: 24px; flex-direction: row; justify-content: center; align-items: center; margin-top: 4px; }
#uniskinEditWeights { height: 24px; flex-direction: row; justify-content: center; align-items: center; margin-top: 4px; }
.uniskin-inspector-icon { width: 16px; height: 16px; margin-right: 4px; flex-shrink: 0; }
.uniskin-rig-action { height: 24px; margin-top: 4px; flex-direction: row; justify-content: center; align-items: center; }
.uniskin-rig-mode-row { flex-direction: row; }
.uniskin-rig-mode-row > .uniskin-rig-action { flex-grow: 1; flex-basis: 0; }
.uniskin-rig-current { border-color: rgb(60, 130, 190); }
.uniskin-rig-hidden { display: none; }
.uniskin-mesh-info { margin-top: 8px; margin-bottom: 4px; }
.uniskin-mesh-info-row { flex-direction: row; margin-top: 2px; margin-bottom: 2px; }
.uniskin-mesh-info-title { width: 140px; flex-shrink: 0; }
.uniskin-mesh-info-value { flex-grow: 1; flex-shrink: 1; white-space: normal; }
