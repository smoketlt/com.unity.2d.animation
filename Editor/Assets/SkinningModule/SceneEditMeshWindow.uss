.uniskin-mesh-window { flex-grow: 1; color: #CFCFCF; background-color: #1D2228; font-size: 11px; border-width: 1px; border-color: #14171B; }
.mesh-header { height: 31px; flex-shrink: 0; background-color: #14171B; flex-direction: row; justify-content: flex-end; }
.mesh-window-title { flex-grow: 1; margin: 0; padding-left: 4px; padding-top: 10px; padding-bottom: 11px; font-size: 10px; }
.mesh-header > #windowIcon { width: 16px; height: 16px; align-self: center; margin-left: 5px; flex-shrink: 0; }
.mesh-header > Button { width: 19px; min-width: 19px; margin: 6px 5px 6px 0; font-size: 14px; }
.mesh-body { flex-grow: 0; flex-shrink: 0; padding: 4px; }
.mesh-block { flex-shrink: 0; background-color: #22272E; padding: 6px 3px 3px 4px; }
.mesh-row { flex-direction: row; margin-bottom: 4px; }
.mesh-row > Button { flex-grow: 1; flex-basis: 0; margin-right: 4px; }
.mesh-row > Button.mesh-last-action { margin-right: 0; }
.uniskin-mesh-window Button { height: 24px; margin-top: 0; margin-bottom: 0; margin-left: 0; padding: 0 4px; border-width: 0; border-bottom-width: 1px; border-color: #14171B; border-radius: 0; background-color: #272D35; color: #CFCFCF; flex-direction: row; justify-content: center; align-items: center; }
.uniskin-mesh-window Button:hover { background-color: #313943; }
.uniskin-mesh-window Button:active, .uniskin-mesh-window Button.mesh-active { background-color: #005050; }
.uniskin-mesh-window Button:disabled { color: #737980; }
.uniskin-mesh-window #closeWindow { height: 19px; padding: 0; margin-top: 6px; margin-bottom: 6px; margin-right: 5px; background-color: #BF4D50; color: #EEEEEE; }
.uniskin-mesh-window #closeWindow:hover { background-color: #D65A5D; }
.uniskin-mesh-window #commandIcon { width: 16px; height: 16px; margin-right: 4px; flex-shrink: 0; }
.mesh-options { margin-top: 4px; justify-content: center; }
.mesh-options > Toggle { flex-grow: 0; flex-shrink: 0; margin: 0 10px; }
.uniskin-edit-mesh .mesh-options > Toggle { margin-left: 4px; margin-right: 4px; }
.mesh-options > Toggle > .unity-base-field__label { display: none; }
.mesh-options > Toggle > .unity-toggle__input { flex-grow: 0; flex-shrink: 0; justify-content: flex-start; }
.mesh-options .unity-toggle__text { margin-left: 4px; margin-right: 0; }
.mesh-options .unity-toggle__checkmark { width: 14px; height: 14px; margin: 0; border-width: 0; border-radius: 0; background-color: #14171B; background-image: none; justify-content: center; align-items: center; }
.mesh-tick { font-size: 11px; color: #CFCFCF; margin: 0; padding: 0; }
.mesh-options .unity-toggle__checkmark:checked { background-image: none; }
.mesh-hidden { display: none; }
.uniskin-mesh-window Slider, .uniskin-mesh-window SliderInt { height: 20px; margin: 0 0 4px 0; }
.uniskin-mesh-window Slider > .unity-base-field__label, .uniskin-mesh-window SliderInt > .unity-base-field__label { min-width: 100px; }
.uniskin-mesh-window .unity-base-slider__tracker { background-color: #14171B; height: 14px; border-width: 0; border-radius: 0; }
.uniskin-mesh-window .unity-base-slider__dragger { visibility: hidden; }
.uniskin-mesh-window .unity-base-slider__dragger-border { display: none; }
.mesh-slider-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: #4295E8; }
.uniskin-mesh-window .unity-base-slider__text-field { width: 45px; margin-left: 3px; }
.uniskin-mesh-window .unity-text-field__input { background-color: #14171B; color: #CFCFCF; border-width: 0; border-radius: 0; -unity-text-align: middle-right; }
.mesh-count { margin-top: 4px; margin-bottom: 0; }
