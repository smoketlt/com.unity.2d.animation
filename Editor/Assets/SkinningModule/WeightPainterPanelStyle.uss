/**********************************************************************************************************************/
/* WeightPainterPanel                                                                                                 */
/**********************************************************************************************************************/

#WeightPainterPanel.BrushMode {
  height: 280px;
}

#WeightPainterPanel.SliderMode {
  height: 255px;
}

#WeightPainterPanel PopupWindow {
  width: 320px;
}

#WeightPainterPanel.BrushMode #Amount.form-row,
#WeightPainterPanel.BrushMode #SmoothButtonRow.form-row {
  display: none;
}

#SmoothButton,
#PruneButton {
    margin-left: 4px;
    margin-right: 4px;
}

#SmoothButtonRow {
    flex-direction: row;
}

#SmoothButton,
#PruneButton {
    width: 126px;
}

#WeightPainterPanel.SliderMode #Size.form-row,
#WeightPainterPanel.SliderMode #Strength.form-row,
#WeightPainterPanel.SliderMode #Feather.form-row {
  display: none;
}

#WeightPainterPanel.SliderMode #BoneManipulationRow.form-row {
  display: none;
}

#BoneManipulationRow {
  flex-direction: row;
  align-items: center;
}

#ManipulateBonesToggle {
  flex-grow: 1;
  flex-shrink: 0;
  margin-left: 0;
}

#ManipulateBonesToggle > .unity-base-field__label {
  width: 105px;
  min-width: 105px;
  max-width: 105px;
  flex-grow: 0;
  flex-shrink: 0;
  margin-top: 0;
  margin-bottom: 0;
  padding-top: 0;
  padding-bottom: 0;
  -unity-text-align: middle-left;
}

#ManipulateBonesToggle > .unity-toggle__input {
  flex-grow: 1;
  justify-content: flex-start;
}

#RestorePoseButton {
  width: 112px;
  min-width: 112px;
  max-width: 112px;
  flex-grow: 0;
  flex-shrink: 0;
  margin-right: 4px;
}

#WeightsInspector{
    flex : 1;
    margin-left : 4px;
    margin-right : 4px;
}


 #divider{
    height : 2px;
    margin-top:5px;
    margin-bottom:5px;
    background-color: rgba(127,127,127,0.8);
    border-color: rgba(35,35,35,0.8);
}

 .Dark #divider{
   background-color: rgba(85,85,85,0.8);
   border-color: rgba(35,35,35,0.8);
}

.SliderMode #divider{
    height : 2px;
}
